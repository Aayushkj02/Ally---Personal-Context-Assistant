{
  "name": "ally",
  "version": "0.1.0",
  "private": true,
  "description": "Ally — personal context assistant. Phase 1 adds Expo via `npx expo install`, NOT create-expo-app (see ADR-009).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
