<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Permissions the Ally capability layer needs. Declared with the module rather than in
    app.json so they travel with the code that uses them.

    ACCESS_NOTIFICATION_POLICY  DND / Zen  (T3)
    WRITE_SETTINGS              brightness (T4)

    Both are user-granted via a settings screen, not a runtime dialog. Declaring them
    grants nothing on its own - AllyNativeModule.getPermissionStatus() reports the truth.
  -->
  <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
  <uses-permission android:name="android.permission.WRITE_SETTINGS" />

  <!--
    SET_ALARM backs the wake-up alarm (A5.1). It is a NORMAL permission, granted at install,
    and it is the one ACTION_SET_ALARM actually requires.

    It replaces SCHEDULE_EXACT_ALARM, which was declared here for the same feature and was the
    wrong permission for it: SCHEDULE_EXACT_ALARM gates AlarmManager, whose alarms live inside
    the app and never appear in the Clock. Ally hands the request to the phone's own Clock
    instead (ADR-127), so keeping the exact-alarm grant would have meant asking the user for
    something this feature does not use while the permission it does use went undeclared.
  -->
  <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

  <!--
    READ_CALL_LOG backs repeated-caller DETECTION only (CallLogAnalyzer). It never changes
    DND policy and never makes anything ring — Android's own PRIORITY_CATEGORY_REPEAT_CALLERS
    does that. Without this grant the feature reports "permission" and stays silent rather
    than guessing. See ADR-109.
  -->
  <uses-permission android:name="android.permission.READ_CALL_LOG" />

  <!--
    REQUIRED AT targetSdk 30+, and easy to miss. Package visibility hides other apps from
    resolveActivity() unless the intent is declared here, so without this block
    AlarmController.isAvailable() returns false on a phone that plainly has a Clock app — and
    the capability would honestly, and wrongly, report "not supported on this device".
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.SET_ALARM" />
    </intent>
    <intent>
      <action android:name="android.intent.action.DISMISS_ALARM" />
    </intent>
    <intent>
      <action android:name="android.intent.action.SHOW_ALARMS" />
    </intent>
    <!--
      The SAME trap, hit a second time and caught on device. Without this entry
      ContactPicker.isAvailable() returned false and resolvedPicker() returned "none" on a phone
      whose picker then opened perfectly and returned a contact. A naive implementation would have
      reported "not supported on this device" while the feature plainly worked.
    -->
    <intent>
      <action android:name="android.intent.action.PICK" />
      <data android:mimeType="vnd.android.cursor.dir/contact" />
    </intent>
  </queries>

  <!--
    A7.2 - the Focus Guard accessibility service.

    BIND_ACCESSIBILITY_SERVICE is declared as android:permission, which is the opposite of asking
    for a permission: it says only the SYSTEM may bind this service. Its protection level is
    signature, so nothing else could anyway. Ally holds no new permission for this feature.

    exported="true" is REQUIRED and looks wrong. An accessibility service is started by the
    system from outside the app, so it has to be exported to be bindable at all; the android:permission
    line above is what keeps that safe. Setting it false makes the service invisible on the
    accessibility screen and the feature simply never turns on, with no error to explain why.
  -->
  <application>
    <service
      android:name="com.ally.nativemodule.FocusGuardService"
      android:exported="true"
      android:label="@string/ally_focus_guard_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/ally_focus_guard_service" />
    </service>
  </application>

</manifest>
